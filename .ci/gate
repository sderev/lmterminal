#!/usr/bin/env bash
set -euo pipefail

# Local CI remains offline across every Python version; see .ci/README.md.
# GATE_PYTEST_ARGS may narrow tests, e.g. GATE_PYTEST_ARGS='-k completion' gate.
# Paid live tests must be invoked as one pytest case directly, never via gate.

py_versions=(3.10 3.11 3.12 3.13 3.14)

pytest_args=()
if [ -n "${GATE_PYTEST_ARGS:-}" ]; then
    read -r -a extra_args <<<"${GATE_PYTEST_ARGS}"
    pytest_args+=("${extra_args[@]}")
fi
# PYTEST_ADDOPTS is also parsed by pytest. Refuse live selectors before any work,
# including abbreviated options accepted by pytest's argument parser.
for arg in "${pytest_args[@]}" ${PYTEST_ADDOPTS:-}; do
    option=${arg%%=*}
    if [[ "$option" == --?* && ( --run-live == "$option"* || --live-model == "$option"* ) ]]; then
        echo 'gate is offline; invoke tests/live_test.py::test_live_call directly with pytest --run-live --live-model MODEL for a paid request.' >&2
        exit 2
    fi
done
# Keep this last: a custom -m expression must not reselect integration tests.
pytest_args+=("-m" "not integration")

uvx ruff format --check .
uvx ruff check .

if [ -d "tests" ]; then
    for py in "${py_versions[@]}"; do
        echo "Testing with Python $py..."
        uv run --python "$py" --group dev -- pytest -q tests/ "${pytest_args[@]}"
    done
else
    echo "Warning: no tests/ directory; skipping pytest" >&2
fi
